{
  "name": "kadam-student-companion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx --conditions=react-server worker/index.ts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --conditions=react-server prisma/seed.ts",
    "test": "vitest run --project unit && vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "lint:routes": "node scripts/ensure-loading.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@better-auth/prisma-adapter": "1.7.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/mar": "1.0.0",
    "@xmldom/xmldom": "^0.8.15",
    "better-auth": "1.7.10",
    "chrono-node": "2.10.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "jszip": "3.10.1",
    "katex": "0.19.0",
    "lucide-react": "1.59.0",
    "mammoth": "1.13.0",
    "mermaid": "12.2.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rrule": "2.8.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "ts-fsrs": "5.4.2",
    "unpdf": "1.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "22.19.17",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "description": "Kadam — an India-focused AI student companion (Next.js, PostgreSQL, Claude).",
  "engines": {
    "node": ">=22.12"
  }
}
