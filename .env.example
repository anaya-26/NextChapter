# ─────────────────────────────────────────────────────────────────────────────
# NextChapter — environment variables. Copy to `.env` and fill in what you need.
# Nothing here is required except DATABASE_URL, BETTER_AUTH_SECRET and
# APP_ENCRYPTION_KEY. Every optional integration degrades gracefully and the
# Settings → Integrations page shows exactly what is working.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 14+ connection string
DATABASE_URL="postgresql://nextchapter:change-me@localhost:5432/nextchapter_dev?schema=public"
# Separate database used by `npm run test:integration` (it is reset by the tests)
TEST_DATABASE_URL="postgresql://nextchapter:change-me@localhost:5432/nextchapter_test?schema=public"
# Separate database used by `npm run test:e2e` (migrated and reset by the tests)
E2E_DATABASE_URL="postgresql://nextchapter:change-me@localhost:5432/nextchapter_e2e?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app
BETTER_AUTH_URL="http://localhost:3000"

# 32-byte key (base64) used to encrypt OAuth tokens at rest — openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ── AI (Claude) ──────────────────────────────────────────────────────────────
# "anthropic" (default when ANTHROPIC_API_KEY is set), "mock" (labelled test double
# for automated tests/demos only), or "none".
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
# Defaults to claude-opus-5-5
ANTHROPIC_MODEL=""
# Per-student daily AI request cap (usage control)
AI_DAILY_REQUEST_LIMIT="80"
# Allow Claude's server-side web search for finding learning resources (true/false)
AI_WEB_SEARCH_ENABLED="true"

# ── Google (optional) ────────────────────────────────────────────────────────
# One OAuth client powers optional "Sign in with Google" and Google Calendar sync.
# Authorised redirect URIs to register in Google Cloud Console:
#   {BETTER_AUTH_URL}/api/auth/callback/google
#   {BETTER_AUTH_URL}/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Transcription (optional) ─────────────────────────────────────────────────
# Any service exposing an OpenAI-compatible POST /audio/transcriptions endpoint
# (OpenAI, Groq, or a self-hosted Whisper server). Without it, upload caption
# files (.vtt/.srt) alongside audio/video to get timestamped transcripts.
TRANSCRIPTION_API_URL=""
TRANSCRIPTION_API_KEY=""
TRANSCRIPTION_MODEL="whisper-1"

# ── OCR ──────────────────────────────────────────────────────────────────────
# Local Tesseract OCR for photos/screenshots when AI vision is unavailable.
OCR_LOCAL_ENABLED="true"

# ── Files ────────────────────────────────────────────────────────────────────
# Private upload storage (outside the public web root)
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="25"
MAX_MEDIA_UPLOAD_MB="200"

# ── Opportunities (optional) ─────────────────────────────────────────────────
# JSON array of permitted RSS/Atom/JSON feeds, e.g.
# [{"name":"Example","url":"https://example.org/feed.xml","format":"rss","permittedNote":"Publisher allows syndication"}]
OPPORTUNITY_FEEDS=""

# ── Background processing ────────────────────────────────────────────────────
# "true" runs the job worker inside the web server (fine for one instance).
# Otherwise run `npm run worker` as a separate process.
RUN_WORKER_IN_PROCESS="true"

# ── Development & testing ────────────────────────────────────────────────────
# Per-student simulated clock for testing time-based features (never enable in production)
ENABLE_TEST_CLOCK="false"
# Shows tools that load clearly labelled demonstration history
ENABLE_DEMO_TOOLS="false"
# `npm run db:seed` can create a local demo student with labelled demo history.
# Development only; there is no default password.
SEED_DEMO_ACCOUNT="false"
SEED_DEMO_EMAIL="demo@example.com"
SEED_DEMO_PASSWORD=""
